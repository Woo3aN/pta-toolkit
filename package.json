{
  "name": "pta-toolkit",
  "displayName": "PTA Toolkit for VS Code",
  "description": "把拼题A（PTA）题集的题目、输入输出、样例拉取到本地：每题一个文件夹，可直接写代码、跑样例、整理笔记",
  "version": "0.3.0",
  "publisher": "woo3an",
  "license": "MIT",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pta",
    "pintia",
    "拼题A",
    "oj",
    "算法"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pta.login",
        "title": "PTA: 登录",
        "icon": "$(sign-in)"
      },
      {
        "command": "pta.loginWechat",
        "title": "PTA: 微信扫码登录",
        "icon": "$(device-mobile)"
      },
      {
        "command": "pta.loginWithCookie",
        "title": "PTA: 粘贴 Cookie 登录",
        "icon": "$(clippy)"
      },
      {
        "command": "pta.logout",
        "title": "PTA: 退出登录",
        "icon": "$(sign-out)"
      },
      {
        "command": "pta.pullFromUrl",
        "title": "PTA: 从链接拉取（题目 / 题集）",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pta.pullMyProblemSet",
        "title": "PTA: 拉取我的题集",
        "icon": "$(list-unordered)"
      },
      {
        "command": "pta.pullPublicProblemSet",
        "title": "PTA: 浏览公开题集",
        "icon": "$(library)"
      },
      {
        "command": "pta.chooseWorkspaceRoot",
        "title": "PTA: 选择工作区根目录",
        "icon": "$(folder-opened)"
      },
      {
        "command": "pta.openWorkspace",
        "title": "PTA: 打开题解工作区",
        "icon": "$(folder)"
      },
      {
        "command": "pta.refreshCurrentProblem",
        "title": "PTA: 刷新当前题目的题面与样例",
        "icon": "$(refresh)"
      },
      {
        "command": "pta.runSamples",
        "title": "PTA: 运行当前题目的样例",
        "icon": "$(play)"
      },
      {
        "command": "pta.submitCurrent",
        "title": "PTA: 提交当前文件到 PTA",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "pta.testCurrent",
        "title": "PTA: 在线测试当前文件（自定义数据，不计分）",
        "icon": "$(beaker)"
      },
      {
        "command": "pta.showLastSubmission",
        "title": "PTA: 查看这道题的最近一次提交",
        "icon": "$(history)"
      },
      {
        "command": "pta.showSubmissions",
        "title": "PTA: 查看这道题的提交记录",
        "icon": "$(list-ordered)"
      },
      {
        "command": "pta.syncNotes",
        "title": "PTA: 把源码里的笔记同步到 notes.md",
        "icon": "$(note)"
      },
      {
        "command": "pta.openStatement",
        "title": "PTA: 打开当前题面",
        "icon": "$(book)"
      },
      {
        "command": "pta.switchLanguage",
        "title": "PTA: 切换 / 新建解题语言",
        "icon": "$(code)"
      },
      {
        "command": "pta.openProblemSetIndex",
        "title": "PTA: 打开题集索引",
        "icon": "$(book)"
      },
      {
        "command": "pta.toggleFavorite",
        "title": "PTA: 收藏 / 取消收藏当前题目",
        "icon": "$(star)"
      },
      {
        "command": "pta.openFavorites",
        "title": "PTA: 打开收藏夹",
        "icon": "$(star-full)"
      },
      {
        "command": "pta.searchProblem",
        "title": "PTA: 搜索题目",
        "icon": "$(search)"
      },
      {
        "command": "pta.refreshSearchIndex",
        "title": "PTA: 刷新题目索引",
        "icon": "$(refresh)"
      },
      {
        "command": "pta.refreshProblemStatus",
        "title": "PTA: 刷新题集的做题状态",
        "icon": "$(checklist)"
      },
      {
        "command": "pta.checkin",
        "title": "PTA: 每日签到",
        "icon": "$(calendar)"
      },
      {
        "command": "pta.refreshTree",
        "title": "PTA: 刷新题目集列表",
        "icon": "$(refresh)"
      },
      {
        "command": "pta.previewProblem",
        "title": "PTA: 预览题目（题面 + 创建代码）",
        "icon": "$(preview)"
      },
      {
        "command": "pta.openItem",
        "title": "PTA: 打开本地题目文件",
        "icon": "$(go-to-file)"
      },
      {
        "command": "pta.pullItem",
        "title": "PTA: 拉取这道题到本地",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pta.pullSet",
        "title": "PTA: 拉取整个题集到本地",
        "icon": "$(cloud-download)"
      },
      {
        "command": "pta.favoriteItem",
        "title": "PTA: 收藏 / 取消收藏这道题",
        "icon": "$(star)"
      },
      {
        "command": "pta.openItemInBrowser",
        "title": "PTA: 在浏览器中打开这道题",
        "icon": "$(link-external)"
      },
      {
        "command": "pta.diagnose",
        "title": "PTA: 诊断（导出原始 JSON）",
        "icon": "$(bug)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pta.login",
          "when": "true"
        },
        {
          "command": "pta.loginWechat",
          "when": "true"
        },
        {
          "command": "pta.loginWithCookie",
          "when": "true"
        },
        {
          "command": "pta.logout",
          "when": "true"
        },
        {
          "command": "pta.pullFromUrl",
          "when": "true"
        },
        {
          "command": "pta.pullMyProblemSet",
          "when": "true"
        },
        {
          "command": "pta.pullPublicProblemSet",
          "when": "true"
        },
        {
          "command": "pta.chooseWorkspaceRoot",
          "when": "true"
        },
        {
          "command": "pta.openWorkspace",
          "when": "true"
        },
        {
          "command": "pta.refreshCurrentProblem",
          "when": "true"
        },
        {
          "command": "pta.runSamples",
          "when": "true"
        },
        {
          "command": "pta.submitCurrent",
          "when": "true"
        },
        {
          "command": "pta.testCurrent",
          "when": "true"
        },
        {
          "command": "pta.showLastSubmission",
          "when": "true"
        },
        {
          "command": "pta.showSubmissions",
          "when": "true"
        },
        {
          "command": "pta.syncNotes",
          "when": "true"
        },
        {
          "command": "pta.openStatement",
          "when": "true"
        },
        {
          "command": "pta.switchLanguage",
          "when": "true"
        },
        {
          "command": "pta.openProblemSetIndex",
          "when": "true"
        },
        {
          "command": "pta.toggleFavorite",
          "when": "true"
        },
        {
          "command": "pta.openFavorites",
          "when": "true"
        },
        {
          "command": "pta.searchProblem",
          "when": "true"
        },
        {
          "command": "pta.refreshSearchIndex",
          "when": "true"
        },
        {
          "command": "pta.refreshProblemStatus",
          "when": "true"
        },
        {
          "command": "pta.checkin",
          "when": "true"
        },
        {
          "command": "pta.refreshTree",
          "when": "true"
        },
        {
          "command": "pta.previewProblem",
          "when": "true"
        },
        {
          "command": "pta.openItem",
          "when": "false"
        },
        {
          "command": "pta.pullItem",
          "when": "false"
        },
        {
          "command": "pta.pullSet",
          "when": "false"
        },
        {
          "command": "pta.favoriteItem",
          "when": "false"
        },
        {
          "command": "pta.openItemInBrowser",
          "when": "false"
        },
        {
          "command": "pta.diagnose",
          "when": "true"
        }
      ],
      "editor/title": [
        {
          "command": "pta.submitCurrent",
          "group": "navigation",
          "when": "resourceFilename =~ /main\\.(c|cpp|py)$|Main\\.java$/"
        },
        {
          "command": "pta.runSamples",
          "group": "navigation",
          "when": "resourceFilename =~ /main\\.(c|cpp|py)$|Main\\.java$/"
        }
      ],
      "view/title": [
        {
          "command": "pta.refreshTree",
          "when": "view == pta.problemSets",
          "group": "navigation@1"
        },
        {
          "command": "pta.searchProblem",
          "when": "view == pta.problemSets",
          "group": "navigation@2"
        },
        {
          "command": "pta.chooseWorkspaceRoot",
          "when": "view == pta.problemSets",
          "group": "navigation@3"
        },
        {
          "command": "pta.login",
          "when": "view == pta.problemSets && !pta.signedIn",
          "group": "navigation@4"
        },
        {
          "command": "pta.logout",
          "when": "view == pta.problemSets && pta.signedIn",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "pta.pullItem",
          "when": "view == pta.problemSets && viewItem =~ /^pta\\.problem/",
          "group": "inline@1"
        },
        {
          "command": "pta.previewProblem",
          "when": "view == pta.problemSets && viewItem =~ /^pta\\.problem/",
          "group": "1_actions@0"
        },
        {
          "command": "pta.favoriteItem",
          "when": "view == pta.problemSets && viewItem =~ /^pta\\.problem/",
          "group": "1_actions@1"
        },
        {
          "command": "pta.openItemInBrowser",
          "when": "view == pta.problemSets && viewItem =~ /^pta\\.problem/",
          "group": "1_actions@2"
        },
        {
          "command": "pta.showLastSubmission",
          "when": "view == pta.problemSets && viewItem =~ /^pta\\.problem/",
          "group": "1_actions@3"
        },
        {
          "command": "pta.showSubmissions",
          "when": "view == pta.problemSets && viewItem =~ /^pta\\.problem/",
          "group": "1_actions@4"
        },
        {
          "command": "pta.pullSet",
          "when": "view == pta.problemSets && viewItem =~ /^pta\\.set/",
          "group": "inline@1"
        },
        {
          "command": "pta.refreshProblemStatus",
          "when": "view == pta.problemSets && viewItem =~ /^pta\\.set/",
          "group": "1_actions@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pta",
          "title": "PTA",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pta": [
        {
          "id": "pta.problemSets",
          "name": "题目集",
          "icon": "media/icon.svg"
        }
      ]
    },
    "snippets": [
      {
        "language": "cpp",
        "path": "./snippets/pta.json"
      },
      {
        "language": "c",
        "path": "./snippets/pta.json"
      },
      {
        "language": "python",
        "path": "./snippets/pta-python.json"
      },
      {
        "language": "java",
        "path": "./snippets/pta.json"
      }
    ],
    "configuration": {
      "title": "PTA Toolkit",
      "properties": {
        "pta.workspaceRoot": {
          "type": "string",
          "default": "",
          "markdownDescription": "题解本地工作区根目录。留空时首次拉取会弹出文件夹选择框。",
          "scope": "resource"
        },
        "pta.defaultLanguage": {
          "type": "string",
          "enum": [
            "C++",
            "C",
            "Python",
            "Java"
          ],
          "default": "C++",
          "description": "新建题目时默认使用的语言。"
        },
        "pta.autoCreateSource": {
          "type": "boolean",
          "default": true,
          "description": "拉取题目时自动创建源码文件。已存在的源码文件永远不会被覆盖。"
        },
        "pta.createNotesFile": {
          "type": "boolean",
          "default": true,
          "description": "每道题额外创建一个 notes.md 用来写笔记。已存在的笔记永远不会被覆盖。"
        },
        "pta.codeNotes": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "在新建的源码里放一个空的 `@pintia note` 块（会随代码一起提交到 PTA），并提供「把源码里的笔记同步到 notes.md」命令。**默认关闭** —— 笔记建议直接写在 Obsidian 里。"
        },
        "pta.templateDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "自定义模板目录。若设置了该目录且其中存在与语言对应的文件（如 `main.cpp`、`main.py`），则用它作为新建源码的内容；否则使用内置最小模板。",
          "scope": "resource"
        },
        "pta.enableLocalTest": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "开启后，拉取题目时会往工作区 `.vscode/tasks.json` 写入本题的编译 / 运行任务，并可用 `PTA: 运行当前题目的样例` 直接跑样例。关掉则只导出题面与样例。"
        },
        "pta.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Python 解释器路径。留空则自动探测常见安装位置与 PATH。",
          "scope": "resource"
        },
        "pta.requestInterval": {
          "type": "number",
          "default": 600,
          "description": "连续请求 PTA 之间的间隔（毫秒），避免触发限流。"
        },
        "pta.fileNameFormat": {
          "type": "string",
          "default": "{label}-{title}",
          "markdownDescription": "每道题的文件夹命名格式。可用变量：`{label}`（题号，如 练习2-1）、`{title}`（标题）、`{pid}`（题目 ID）。"
        },
        "pta.includeNonProgramming": {
          "type": "boolean",
          "default": false,
          "description": "拉取题集时是否包含非编程题（如代码填空题）。"
        }
      }
    }
  },
  "scripts": {
    "pack": "python tools/build-vsix.py"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Woo3aN/pta-toolkit"
  }
}
